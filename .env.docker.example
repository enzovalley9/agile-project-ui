# Copy to .env beside compose.yaml. This file contains configuration, never secrets.
# Pin a published GHCR tag/digest for reproducible installs.
# To use a source build, change this to agile-project-ui:local.
AGILE_IMAGE=ghcr.io/enzovalley9/agile-project-ui:latest
AGILE_WEB_ORIGIN=http://127.0.0.1:8080

# Container identity. On native Linux replace with your id -u and id -g values.
# On Docker Desktop start with 1000:1000; check bind-mount ownership in the guide.
AGILE_UID=1000
AGILE_GID=1000

# Optional Git profile: existing absolute repository root, same folder as browser.
# AGILE_PROJECT_DIR=/absolute/path/to/project
# AGILE_GIT_STATE_DIR=/absolute/private/path/git
# Docker Desktop only: after verifying the exact mounted repository, set 1 if
# synthetic ownership causes Git's dubious-ownership refusal. Default is 0.
# AGILE_GIT_ALLOW_MAPPED_OWNERSHIP=0
# Optional commit identity. Set all four, or use identity in repository config.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# Optional Jira profile. Credential JSON is mounted read-only; never paste tokens here.
# AGILE_JIRA_INSTANCE=https://your-site.atlassian.net
# AGILE_JIRA_DEPLOYMENT=cloud
# AGILE_JIRA_STATE_DIR=/absolute/private/path/jira
# AGILE_JIRA_CREDENTIALS_FILE=/absolute/private/path/jira-credentials.json

# Optional Confluence profile. Use cloud or data-center for the deployment.
# AGILE_CONFLUENCE_INSTANCE=https://your-site.atlassian.net/wiki
# AGILE_CONFLUENCE_DEPLOYMENT=cloud
# AGILE_CONFLUENCE_STATE_DIR=/absolute/private/path/confluence
# AGILE_CONFLUENCE_CREDENTIALS_FILE=/absolute/private/path/confluence-credentials.json
