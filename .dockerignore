# Only maintained build inputs enter Docker. No Git history, user projects,
# private planning, fixtures, dependencies, local environment or credentials.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!.node-version
!LICENSE
!THIRD_PARTY_NOTICES.md
!README.md
!SUPPORT.md
!SECURITY.md
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!compose.yaml
!.env.docker.example
!docs/
!docs/connector-setup.md
!docs/architecture.md
!docs/git-connector.md
!docs/atlassian-connectors.md
!docs/development.md
!docs/testing.md
!docs/hosting.md
!docs/releases.md
!docs/docker.md
!docs/supply-chain.md
!docs/compatibility.md
!docs/privacy.md
!docs/roadmap.md
!docs/first-use.md
!docs/maintaining.md
!docs/signing.md
!docs/screenshots/
!docs/screenshots/*.png
!examples/
!examples/community-garden.json
!apps/
!apps/web/
!apps/web/index.html
!apps/web/vite.config.ts
!apps/web/public/
!apps/web/public/_headers
!apps/web/src/
!apps/web/src/**
!apps/git-connector/
!apps/git-connector/src/
!apps/git-connector/src/**
!apps/atlassian-connector/
!apps/atlassian-connector/src/
!apps/atlassian-connector/src/**
!packages/
!packages/*/
!packages/*/src/
!packages/*/src/**
!scripts/
!scripts/build-connectors.mjs
!scripts/build-example.mjs
!scripts/build-public-help.mjs
!scripts/build-revision.mjs
!scripts/check-public-assets.mjs
!scripts/copy-web-notices.mjs
!docker/
!docker/runtime.mjs
!docker/web-server.mjs
!docker/healthcheck.mjs
!docker/collect-sources.mjs
!docker/container-sbom.mjs
!docker/openssh-source.json
!docker/build-openssh.mjs
!docker/ssh-smoke.mjs
!docker/verify-distribution.mjs
**/.env
**/.env.*
!.env.docker.example
**/*.pem
**/*.key
**/credentials*.json
